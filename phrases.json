[
  {"en": "Hello, how are you?", "pt": "Olá, como você está?", "pron": "rê-LÔU, rau a iú?", "ipa": "/həˈloʊ haʊ ɑːr juː/", "tip": "O 'h' de 'hello' e 'how' é um 'r' suave, soprado.", "image": "two friends greeting each other and waving"},
  {"en": "My name is Ana.", "pt": "Meu nome é Ana.", "pron": "mai NÊIM iz Ana", "ipa": "/maɪ neɪm ɪz ˈænə/", "tip": "'name' soa como 'nêim', com o som de ditongo.", "image": "person introducing themselves with a name tag"},
  {"en": "Nice to meet you.", "pt": "Prazer em conhecer você.", "pron": "nais tu MIIT iú", "ipa": "/naɪs tuː miːt juː/", "tip": "'meet' tem o 'i' longo: miiit.", "image": "two people shaking hands smiling"},
  {"en": "Where is the bathroom?", "pt": "Onde fica o banheiro?", "pron": "uér iz dhi BÉ-th-rum", "ipa": "/wɛr ɪz ðə ˈbæθruːm/", "tip": "O 'th' é com a língua entre os dentes.", "image": "sign pointing to the restroom in a cafe"},
  {"en": "I would like a coffee, please.", "pt": "Eu gostaria de um café, por favor.", "pron": "ai uúd laik a CÓ-fi, pliiz", "ipa": "/aɪ wʊd laɪk ə ˈkɔːfi pliːz/", "tip": "'would' tem o 'l' mudo: uúd.", "image": "person ordering coffee at a cafe counter"},
  {"en": "How much is it?", "pt": "Quanto custa?", "pron": "rau mâtch iz it", "ipa": "/haʊ mʌtʃ ɪz ɪt/", "tip": "'much' termina com som de 'tch'.", "image": "customer asking price at a shop with a price tag"},
  {"en": "I don't understand.", "pt": "Eu não entendo.", "pron": "ai DÔNT ân-der-STÉND", "ipa": "/aɪ doʊnt ˌʌndərˈstænd/", "tip": "Ênfase na última sílaba: under-STAND.", "image": "confused person with question marks"},
  {"en": "Could you repeat, please?", "pt": "Você poderia repetir, por favor?", "pron": "cud iú ri-PIIT, pliiz", "ipa": "/kʊd juː rɪˈpiːt pliːz/", "tip": "Ótima frase para quando não ouvir direito.", "image": "person cupping ear to hear better"},
  {"en": "Thank you very much.", "pt": "Muito obrigado.", "pron": "THÉNK iú VÉ-ri mâtch", "ipa": "/θæŋk juː ˈvɛri mʌtʃ/", "tip": "'th' de 'thank' com a língua entre os dentes, sem 'f'.", "image": "person smiling and giving a thank you gift"},
  {"en": "You're welcome.", "pt": "De nada.", "pron": "iór UÉL-câm", "ipa": "/jʊr ˈwɛlkəm/", "tip": "'welcome' soa 'uélcâm'.", "image": "friendly waiter smiling at a customer"},
  {"en": "Excuse me.", "pt": "Com licença / Desculpe.", "pron": "ik-SKIÚZ mi", "ipa": "/ɪkˈskjuːz miː/", "tip": "O 'z' final de 'excuse' é vibrado.", "image": "person politely getting attention in a crowd"},
  {"en": "I'm sorry.", "pt": "Sinto muito / Desculpa.", "pron": "aim SÓ-ri", "ipa": "/aɪm ˈsɑːri/", "tip": "Não é 'sórri' paulistano, o 'r' é suave.", "image": "person apologizing with hand on chest"},
  {"en": "What time is it?", "pt": "Que horas são?", "pron": "uót taim iz it", "ipa": "/wʌt taɪm ɪz ɪt/", "tip": "No inglês falado, 'is it' vira 'izit'.", "image": "person looking at a wristwatch"},
  {"en": "I am hungry.", "pt": "Estou com fome.", "pron": "ai ém RÂN-gri", "ipa": "/aɪ æm ˈhʌŋgri/", "tip": "'hungry' = RÂN-gri.", "image": "person holding stomach looking at food"},
  {"en": "I am tired.", "pt": "Estou cansado.", "pron": "ai ém TAI-erd", "ipa": "/aɪ æm ˈtaɪərd/", "tip": "'tired' tem uma sílaba só: taiérd.", "image": "tired person yawning at a desk"},
  {"en": "Good morning!", "pt": "Bom dia!", "pron": "gud MÓR-nin", "ipa": "/ɡʊd ˈmɔːrnɪŋ/", "tip": "'good' é curto: gud, não 'gúdi'.", "image": "sunrise with a cup of coffee on a window sill"},
  {"en": "Good night!", "pt": "Boa noite!", "pron": "gud NAIT", "ipa": "/ɡʊd naɪt/", "tip": "'gh' em 'night' é mudo.", "image": "moon and stars over a sleeping house"},
  {"en": "See you tomorrow.", "pt": "Vejo você amanhã.", "pron": "sii iú tu-MÓ-rôu", "ipa": "/siː juː təˈmɑːroʊ/", "tip": "Ênfase em 'MOR': tu-MOR-rou.", "image": "two friends waving goodbye at sunset"},
  {"en": "I like pizza.", "pt": "Eu gosto de pizza.", "pron": "ai LAIK PIT-sa", "ipa": "/aɪ laɪk ˈpiːtsə/", "tip": "O 'zz' de pizza soa 'ts'.", "image": "person happily eating a slice of pizza"},
  {"en": "Do you speak English?", "pt": "Você fala inglês?", "pron": "du iú SPIIK ÍN-glish", "ipa": "/duː juː spiːk ˈɪŋɡlɪʃ/", "tip": "'speak' tem 'i' longo: spiiik.", "image": "two people talking with speech bubbles"},
  {"en": "I'm learning English.", "pt": "Estou aprendendo inglês.", "pron": "aim LÉR-nin ÍN-glish", "ipa": "/aɪm ˈlɜːrnɪŋ ˈɪŋɡlɪʃ/", "tip": "'ing' final soa 'in', quase sem o 'g'.", "image": "student studying English with a book and headphones"},
  {"en": "Can you help me?", "pt": "Você pode me ajudar?", "pron": "quén iú RÉLP mi", "ipa": "/kæn juː hɛlp miː/", "tip": "'can' fraco, quase 'quên', no meio da frase.", "image": "person asking a stranger for help on the street"},
  {"en": "I need water.", "pt": "Eu preciso de água.", "pron": "ai NIID UÓ-ter", "ipa": "/aɪ niːd ˈwɔːtər/", "tip": "'water' americano soa 'uóRer', o 't' vira um 'd' rápido.", "image": "glass of water on a table"},
  {"en": "Where are you from?", "pt": "De onde você é?", "pron": "uér ar iú FRÂM", "ipa": "/wɛr ɑːr juː frʌm/", "tip": "'from' soa 'frâm'.", "image": "world map with a person pointing at a country"},
  {"en": "I am from Brazil.", "pt": "Eu sou do Brasil.", "pron": "ai ém frâm bra-ZIL", "ipa": "/aɪ æm frʌm brəˈzɪl/", "tip": "Em inglês, 'Brazil' termina em 'zil', com z.", "image": "person holding a Brazilian flag"},
  {"en": "It's a beautiful day.", "pt": "Está um lindo dia.", "pron": "its a BIÚ-ti-ful dêi", "ipa": "/ɪts ə ˈbjuːtɪfəl deɪ/", "tip": "'beautiful' = BIÚ-ti-ful (3 sílabas).", "image": "sunny park with a blue sky"},
  {"en": "What is your favorite color?", "pt": "Qual é a sua cor favorita?", "pron": "uót iz iór FÊI-vrit KÂ-ler", "ipa": "/wʌt ɪz jʊr ˈfeɪvərɪt ˈkʌlər/", "tip": "'favorite' costuma ter 2 sílabas: FEIV-rit.", "image": "colorful paint palette with brushes"},
  {"en": "I have a dog.", "pt": "Eu tenho um cachorro.", "pron": "ai RÉV a DÓG", "ipa": "/aɪ hæv ə dɔːɡ/", "tip": "'have' soa 'rév', com o 'a' aberto.", "image": "happy person with a dog in a park"},
  {"en": "Let's go!", "pt": "Vamos!", "pron": "LÉTS GÔU", "ipa": "/lɛts ɡoʊ/", "tip": "'go' é um ditongo: gôu.", "image": "group of friends running excitedly"}
]
